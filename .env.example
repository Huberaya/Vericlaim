# Copy this file to .env for local Compose. Never commit real secrets, provider
# credentials or registry snapshots.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Compose assembles DATABASE_URL from POSTGRES_PASSWORD. For a direct backend
# deployment, set DATABASE_URL explicitly (mandatory outside development/test).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/vericlaim
APP_ENV=development
# APP_ENV must be set EXPLICITLY on a shared platform. Serverless hosts inject
# VERCEL_ENV/VERCEL; without APP_ENV the 'development' default would re-enable the
# credential-less pilot route, point at SQLite, disable secure cookies and accept
# localhost CORS. The application refuses to start when those disagree.
# Local Compose applies Alembic migrations before startup. Keep this false in
# staging/production; AUTO_CREATE_SCHEMA is only an isolated development/test aid.
AUTO_CREATE_SCHEMA=false

# Development-only resilience aid. When true and the configured database is
# unreachable, the API serves from a throwaway SQLite file instead of failing.
# That silently bypasses PostgreSQL row-level security and loses writes on an
# ephemeral filesystem, so it is refused outside development/test.
# Default: false. An unreachable database returns HTTP 503.
# ALLOW_LOCAL_SQLITE_FALLBACK=false

# Browser/session security. Generate at least 32 random characters, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-characters
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Report signature (C7). Generate at least 32 random characters, with at least
# 16 distinct ones; weak or placeholder values are refused in staging/production.
# Required in staging/production: no report can be trusted without it. Rotating it
# makes previously issued reports fail verification.
REPORT_SIGNING_KEY=replace-with-a-long-random-report-signing-key-at-least-32-chars

# Report generation queue (C22). The API never renders a report in the request:
# it enqueues a job, and the dedicated `report-worker` service (see
# docker-compose.yml) renders it. Capacity is scaled by adding worker replicas
# (`docker compose up --scale report-worker=4`); nothing else is configured.
# These are per-organization limits, not instance limits: one customer cannot
# fill the queue nor occupy every worker.
# REPORT_MAX_ATTEMPTS=3
# REPORT_RETRY_BASE_SECONDS=60
# REPORT_LEASE_SECONDS=600
# REPORT_POLL_SECONDS=3
# REPORT_MAX_PENDING_PER_ORGANIZATION=25
# REPORT_MAX_RUNNING_PER_ORGANIZATION=3
# REPORT_DOWNLOAD_MAX_BYTES=67108864

# Local pilot shortcut. When true, POST /api/v1/auth/dev-login creates an owner
# session WITHOUT any credential, and the UI shows a "espace pilote" button.
# Default: enabled in development/test, disabled everywhere else. Enabling it in
# staging/production is a startup error, not a silent exposure. Set to false to
# require a real SSO login even locally.
# ENABLE_DEV_LOGIN=false

# Generic OIDC / SSO. OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_REDIRECT_URI are
# required together in staging/production; OIDC_CLIENT_SECRET is needed only
# for a confidential client. Development may omit them, in which case the UI
# safely reports that SSO is not configured instead of exposing a local-password bypass.
# OIDC_ISSUER=https://idp.example.com/realms/vericlaim
# OIDC_CLIENT_ID=vericlaim-web
# OIDC_CLIENT_SECRET=only-if-confidential-client
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# OIDC_DISCOVERY_URL=https://idp.example.com/realms/vericlaim/.well-known/openid-configuration

NEXT_PUBLIC_API_URL=http://localhost:8000
EU_2024_825_FR_TRANSPOSITION_STATUS=unknown
# A JSON list of server-verified certificate records; empty means no certificate can activate a Safe Harbor.
VERICLAIM_CERTIFICATE_REGISTRY_JSON=[]

# Local secure-document stack. Compose uses these credentials only for its
# private development MinIO instance; use a least-privilege application identity
# or workload identity in a shared deployment, never a storage root account.
MINIO_ROOT_USER=vericlaim-dev-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000
DOCUMENT_QUARANTINE_BUCKET=vericlaim-quarantine
DOCUMENT_CLEAN_BUCKET=vericlaim-documents
DOCUMENT_STORAGE_REGION=eu-west-3
# Browser-visible endpoint used only in signed URLs. The backend uses its
# private Docker endpoint automatically in docker-compose.yml.
DOCUMENT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
DOCUMENT_UPLOAD_TTL_SECONDS=900
DOCUMENT_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_CLAMAV_TIMEOUT_SECONDS=30

# Durable OCR/extraction worker. The queue itself is PostgreSQL-backed; no
# Redis/RabbitMQ broker is required for this MVP. The lease must cover the
# configured page count and OCR page timeout.
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_BASE_SECONDS=30
DOCUMENT_EXTRACTION_LEASE_SECONDS=900
DOCUMENT_EXTRACTION_POLL_SECONDS=2
DOCUMENT_OCR_TIMEOUT_SECONDS=20
DOCUMENT_OCR_RENDER_SCALE=2
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_SEGMENT_MAX_CHARS=2000
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=25

# Durable deterministic claim-detection worker. This worker only analyzes
# immutable C4 segments; it performs no LLM/RAG, regulatory verdict, evidence
# matching, recommendation, or legal score.
ANALYSIS_DETECTION_MAX_ATTEMPTS=3
ANALYSIS_DETECTION_RETRY_BASE_SECONDS=30
ANALYSIS_DETECTION_LEASE_SECONDS=300
ANALYSIS_DETECTION_POLL_SECONDS=2

# Shared MinIO + ClamAV deployment (do not copy the local values above):
# DOCUMENT_STORAGE_BACKEND=s3
# DOCUMENT_STORAGE_ENDPOINT=https://minio.internal.example
# DOCUMENT_STORAGE_PUBLIC_ENDPOINT=https://objects.example
# DOCUMENT_STORAGE_ACCESS_KEY=minio-least-privilege-service-account
# DOCUMENT_STORAGE_SECRET_KEY=replace-with-a-service-account-secret
# Document storage must use a TLS/KMS-enabled MinIO deployment outside dev/test.
# DOCUMENT_STORAGE_SSE_MODE=aws:kms
# DOCUMENT_STORAGE_SSE_KMS_KEY_ID=vericlaim-document-key
# The MinIO CORS allow-list must contain only the web origin, e.g.
# MINIO_API_CORS_ALLOW_ORIGIN=https://app.example
# DOCUMENT_SCANNER_MODE=clamav
# DOCUMENT_CLAMAV_HOST=clamav.internal.example
# DOCUMENT_CLAMAV_PORT=3310

# Workers on a platform scheduler (Vercel Cron) — no permanent process to run the
# three queue loops, so a scheduled call executes one cycle at a time.
# CRON_SECRET is read BY THE PLATFORM: Vercel sends it as `Authorization: Bearer`
# on every cron invocation. Absent, the tick route answers 503 and the queues stay
# full (fail closed) — it does not stop the API from starting.
# CRON_SECRET=replace-with-at-least-32-random-characters
# INTERNAL_WORKER_BUDGET_SECONDS=45
