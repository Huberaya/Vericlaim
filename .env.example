# Copiez ce fichier en `.env` pour le Compose local. Ne jamais committer de secret
# réel, d'identifiant de prestataire ni d'instantané de registre.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Compose assemble DATABASE_URL à partir de POSTGRES_PASSWORD. Pour un déploiement
# du backend seul, définissez DATABASE_URL explicitement (obligatoire hors
# development/test).
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/vericlaim
APP_ENV=development
# APP_ENV doit être défini EXPLICITEMENT sur une plateforme partagée. Les hébergeurs
# sans serveur injectent VERCEL_ENV/VERCEL ; sans APP_ENV, la valeur par défaut
# (« development ») réactiverait la route pilote sans aucun identifiant, pointerait
# vers SQLite, désactiverait les cookies sécurisés et accepterait le CORS localhost.
# L'application refuse de démarrer quand ces valeurs se contredisent.
# Le Compose local applique les migrations Alembic avant le démarrage. Laisser cette
# valeur à false en staging/production : AUTO_CREATE_SCHEMA n'est qu'une aide pour
# development/test isolés.
AUTO_CREATE_SCHEMA=false

# Aide à la résilience, réservée au développement. Quand elle vaut true et que la
# base configurée est injoignable, l'API sert depuis un fichier SQLite jetable au
# lieu d'échouer. Cela contourne silencieusement la sécurité au niveau des lignes
# (RLS) de PostgreSQL et perd les écritures sur un système de fichiers éphémère :
# c'est donc refusé hors development/test.
# Défaut : false. Une base injoignable renvoie HTTP 503.
# ALLOW_LOCAL_SQLITE_FALLBACK=false

# Sécurité du navigateur et de la session. Générer au moins 32 caractères
# aléatoires, par exemple :
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret-at-least-32-characters
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Signature des rapports (C7). Générer au moins 32 caractères aléatoires, dont au
# moins 16 distincts ; une valeur faible ou restée à l'exemple est refusée en
# staging/production. Obligatoire en staging/production : sans elle, aucun rapport
# n'est opposable. La faire tourner rend invérifiables les rapports déjà émis.
REPORT_SIGNING_KEY=replace-with-a-long-random-report-signing-key-at-least-32-chars

# File de génération des rapports (C22). L'API ne rend jamais un rapport dans la
# requête : elle met un travail en file, et le service dédié `report-worker` (voir
# docker-compose.yml) le rend. La capacité s'augmente en ajoutant des répliques du
# worker (`docker compose up --scale report-worker=4`) ; rien d'autre à configurer.
# Ces limites sont par organisation, pas par instance : un client ne peut ni remplir
# la file, ni occuper tous les workers.
# REPORT_MAX_ATTEMPTS=3
# REPORT_RETRY_BASE_SECONDS=60
# REPORT_LEASE_SECONDS=600
# REPORT_POLL_SECONDS=3
# REPORT_MAX_PENDING_PER_ORGANIZATION=25
# REPORT_MAX_RUNNING_PER_ORGANIZATION=3
# REPORT_DOWNLOAD_MAX_BYTES=67108864

# Raccourci pilote local. Quand il vaut true, POST /api/v1/auth/dev-login crée une
# session propriétaire SANS aucun identifiant, et l'interface affiche un bouton
# « espace pilote ». Défaut : activé en development/test, désactivé partout ailleurs.
# L'activer en staging/production est une erreur au démarrage, jamais une exposition
# silencieuse. Mettre false pour exiger un vrai SSO même en local.
# ENABLE_DEV_LOGIN=false

# OIDC / SSO générique. OIDC_ISSUER, OIDC_CLIENT_ID et OIDC_REDIRECT_URI sont exigés
# ensemble en staging/production ; OIDC_CLIENT_SECRET n'est nécessaire que pour un
# client confidentiel. Le développement peut les omettre : l'interface indique alors,
# sans mentir, que le SSO n'est pas configuré, plutôt que d'exposer un contournement
# par mot de passe local.
# OIDC_ISSUER=https://idp.example.com/realms/vericlaim
# OIDC_CLIENT_ID=vericlaim-web
# OIDC_CLIENT_SECRET=only-if-confidential-client
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# OIDC_DISCOVERY_URL=https://idp.example.com/realms/vericlaim/.well-known/openid-configuration

NEXT_PUBLIC_API_URL=http://localhost:8000
EU_2024_825_FR_TRANSPOSITION_STATUS=unknown
# Liste JSON de certificats vérifiés côté serveur ; vide signifie qu'aucun certificat
# ne peut activer un Safe Harbor.
VERICLAIM_CERTIFICATE_REGISTRY_JSON=[]

# Pile documentaire sécurisée locale. Compose n'utilise ces identifiants que pour son
# instance MinIO de développement privée ; dans un déploiement partagé, employer une
# identité applicative à moindres privilèges (ou une identité de charge de travail),
# jamais un compte racine de stockage.
MINIO_ROOT_USER=vericlaim-dev-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000
DOCUMENT_QUARANTINE_BUCKET=vericlaim-quarantine
DOCUMENT_CLEAN_BUCKET=vericlaim-documents
DOCUMENT_STORAGE_REGION=eu-west-3
# Adresse visible du navigateur, utilisée uniquement dans les URLs signées. Le
# backend emploie automatiquement son adresse Docker privée dans docker-compose.yml.
DOCUMENT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
DOCUMENT_UPLOAD_TTL_SECONDS=900
DOCUMENT_DOWNLOAD_TTL_SECONDS=300
DOCUMENT_CLAMAV_TIMEOUT_SECONDS=30

# Worker durable d'OCR et d'extraction. La file elle-même vit dans PostgreSQL :
# aucun courtier Redis/RabbitMQ n'est nécessaire pour ce périmètre. Le bail doit
# couvrir le nombre de pages configuré et le délai d'OCR par page.
DOCUMENT_EXTRACTION_MAX_ATTEMPTS=3
DOCUMENT_EXTRACTION_RETRY_BASE_SECONDS=30
DOCUMENT_EXTRACTION_LEASE_SECONDS=900
DOCUMENT_EXTRACTION_POLL_SECONDS=2
DOCUMENT_OCR_TIMEOUT_SECONDS=20
DOCUMENT_OCR_RENDER_SCALE=2
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_SEGMENT_MAX_CHARS=2000
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=25

# Worker durable et déterministe de détection des allégations. Ce worker n'analyse
# que les segments C4, immuables ; il ne fait ni LLM/RAG, ni verdict réglementaire,
# ni rapprochement de preuves, ni recommandation, ni score juridique.
ANALYSIS_DETECTION_MAX_ATTEMPTS=3
ANALYSIS_DETECTION_RETRY_BASE_SECONDS=30
ANALYSIS_DETECTION_LEASE_SECONDS=300
ANALYSIS_DETECTION_POLL_SECONDS=2

# Déploiement MinIO + ClamAV partagé (ne pas recopier les valeurs locales ci-dessus) :
# DOCUMENT_STORAGE_BACKEND=s3
# DOCUMENT_STORAGE_ENDPOINT=https://minio.internal.example
# DOCUMENT_STORAGE_PUBLIC_ENDPOINT=https://objects.example
# DOCUMENT_STORAGE_ACCESS_KEY=minio-least-privilege-service-account
# DOCUMENT_STORAGE_SECRET_KEY=replace-with-a-service-account-secret
# Hors development/test, le stockage doit être un MinIO avec TLS et gestion de clés.
# DOCUMENT_STORAGE_SSE_MODE=aws:kms
# DOCUMENT_STORAGE_SSE_KMS_KEY_ID=vericlaim-document-key
# La liste CORS autorisée du MinIO doit contenir uniquement l'origine web, par ex.
# MINIO_API_CORS_ALLOW_ORIGIN=https://app.example
# DOCUMENT_SCANNER_MODE=clamav
# DOCUMENT_CLAMAV_HOST=clamav.internal.example
# DOCUMENT_CLAMAV_PORT=3310

# Workers portés par le planificateur de la plateforme (Vercel Cron) : sans processus
# permanent pour faire tourner les trois boucles de file, un appel planifié exécute un
# cycle à la fois. CRON_SECRET est lu PAR LA PLATEFORME : Vercel l'envoie en
# `Authorization: Bearer` à chaque invocation planifiée. Absent, la route de travail
# répond 503 et les files restent pleines (fermé par défaut) — cela n'empêche pas
# l'API de démarrer.
# CRON_SECRET=replace-with-at-least-32-random-characters
# INTERNAL_WORKER_BUDGET_SECONDS=45
